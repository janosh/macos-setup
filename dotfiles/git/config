[core]
	attributesfile = ~/.config/git/attributes
	excludesfile = ~/.config/git/ignore

[rebase]
	autoStash = true
	autoSquash = true

[push]
	followTags = true
	# https://git-scm.com/docs/git-config#Documentation/git-config.txt-pushautoSetupRemote
	autoSetupRemote = true

[pull]
	ff = only
	rebase = true
